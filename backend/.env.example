# CivicLens Backend Configuration Example
# Copy to backend/.env or set environment variables

# Database
DATABASE_URL=sqlite:///./civiclens.db

# Security & Auth
SECRET_KEY=civiclens_demo_secret_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Services
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AI_DEMO_MODE=false

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
